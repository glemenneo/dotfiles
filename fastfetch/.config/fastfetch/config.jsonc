// Arch logo as an image, sent by path so kitty only (zshrc runs fastfetch only there).
// A config file without "modules" prints no stats, so this is fastfetch's default list.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "/usr/share/pixmaps/archlinux-logo.png",
    "width": 28,
    "height": 14,
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "modules": [
    "title", "separator", "os", "host", "kernel", "uptime", "packages", "shell",
    "display", "de", "wm", "wmtheme", "theme", "icons", "font", "cursor",
    "terminal", "terminalfont", "cpu", "gpu", "memory", "swap", "disk",
    "localip", "battery", "poweradapter", "locale", "break", "colors"
  ]
}
